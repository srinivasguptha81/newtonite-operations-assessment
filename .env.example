# ==========================================
# Newtonite Operations - Environment Configuration
# ==========================================

# Database:
# For production and Docker (PostgreSQL):
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/newtonite

# For local isolated run without Docker (SQLite WAL mode):
# DATABASE_URL=sqlite:///./newtonite.db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=newtonite

# Security
SECRET_KEY=newtonite_secret_key_production_grade_5f8a9e2b1c4d7e6f8a0b2c3d4e5f6a7b
ADMIN_BOOTSTRAP_SECRET=newtonite-initial-bootstrap-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
